# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — Prisma CLI (migrate) URL
# Hostinger prod'da genelde host=127.0.0.1 (localhost IPv6 sorun çıkarabilir)
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME

# Runtime adapter (PrismaMariaDb) — aynı local/prod değerleri
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=USER
DATABASE_PASSWORD=PASSWORD
DATABASE_NAME=DBNAME

# Auth (Prompt 05) — AUTH_SECRET uzun rastgele olmalı (openssl rand -base64 32)
AUTH_SECRET=generate_a_long_random_secret
AUTH_URL=http://localhost:3000

# Admin provisioning (yalnızca CLI — git'e koyma)
# ADMIN_EMAIL=admin@ornek.com
# ADMIN_PASSWORD=en_az_12_karakter_guclu_sifre

# Local: MySQL yokken public sayfaları anında fixture ile aç (admin için kapatın)
# USE_FIXTURES_ONLY=1

# Media (Prompt 08) — Hostinger public_html kalıcı değil; Cloudinary/S3 kullanın
# MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3 (MVP yükleme Cloudinary; env hazırlığı)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
